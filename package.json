{
  "name": "@bookingbutler/widget",
  "version": "0.1.0",
  "description": "Put the BookingButler chat widget on any website, and give its agent tools your page performs: typed loader, host tools with pictures, page context. Framework-free core plus a React kit.",
  "license": "MIT",
  "author": "Market Leader Technologies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Market-Leader-Technologies/bookingbutler-widget.git"
  },
  "homepage": "https://github.com/Market-Leader-Technologies/bookingbutler-widget#readme",
  "bugs": {
    "url": "https://github.com/Market-Leader-Technologies/bookingbutler-widget/issues"
  },
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "bookingbutler",
    "chat",
    "widget",
    "ai-agent",
    "host-tools",
    "react",
    "nextjs"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@9.6.0"
}
